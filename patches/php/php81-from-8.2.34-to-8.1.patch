+$tester->terminate();
+$tester->expectLogWarning(
+    'child %d said into stderr: "ERROR: Connection disallowed: IP address \'::1\' has been dropped."',
+    'prefix'
+);
+$tester->expectLogTerminatingNotices();
+$tester->close();
+
+?>
+Done
+--EXPECT--
+exact: ok
+prefix: error
+Done
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+?>
