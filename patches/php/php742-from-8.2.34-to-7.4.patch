+    $header = substr_replace($header, $size, 124, 12);
+    $header = substr_replace($header, sprintf("%011o\0", 1700000000), 136, 12);
+    $header[156] = $typeflag;
+    $header = substr_replace($header, "ustar\0", 257, 6);
