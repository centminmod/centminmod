+++ b/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt
@@ -0,0 +1,65 @@
+--TEST--
+GHSA-q23r-hr55-xmpg: Out-of-bounds read on empty SOAP-ENC:arraySize
+--EXTENSIONS--
+soap
+--FILE--
+<?php
+
+function echo_back($data) { $GLOBALS['decoded'][] = $data; return null; }
+
+function request(string $arraySize, string $itemType = ''): string {
+    $itemTypeAttribute = $itemType === '' ? '' : "SOAP-ENC:itemType=\"{$itemType}\"";
+
+    return <<<XML
+        <?xml version="1.0"?>
+        <SOAP-ENV:Envelope
+            xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"
+            xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/"
+            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
+
+            <SOAP-ENV:Body SOAP-ENV:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
+                <echo_back>
+                    <data xsi:type="SOAP-ENC:Array" {$itemTypeAttribute} SOAP-ENC:arraySize="{$arraySize}">
+                        <item xsi:type="xsd:string">A</item>
+                        <item xsi:type="xsd:string">B</item>
+                        <item xsi:type="xsd:string">C</item>
+                    </data>
+                </echo_back>
+            </SOAP-ENV:Body>
+        </SOAP-ENV:Envelope>
+        XML;
+}
+
+function decode(SoapServer $server, string $request): string {
+    ob_start();
+    $server->handle($request);
+    $response = ob_get_clean();
+
+    if (str_contains($response, '<SOAP-ENV:Fault>')) {
+        return 'fault: ' . strip_tags($response);
+    }
+
+    return json_encode(array_pop($GLOBALS['decoded']));
+}
+
+$server = new SoapServer(null, ['uri' => 'http://test']);
+$server->addFunction('echo_back');
+
+$GLOBALS['decoded'] = [];
+
+foreach (['', ' ', 'abc', '*', '3', '2 2'] as $arraySize) {
+    echo var_export($arraySize, true), ' => ', decode($server, request($arraySize)), "\n";
+}
+
+echo "itemType => ", decode($server, request('', 'xsd:string')), "\n";
+
+?>
+--EXPECT--
+'' => ["A","B","C"]
+' ' => ["A","B","C"]
+'abc' => ["A","B","C"]
+'*' => ["A","B","C"]
+'3' => ["A","B","C"]
+'2 2' => [["A","B"],["C"]]
+itemType => ["A","B","C"]
From: Alexandre Daubois <alex.daubois@gmail.com>
Date: Fri, 13 Nov 2026 08:33:23 +0100
Subject: Fix GHSA-68fq-fh7h-f8gr: refuse keyless phar signature when .pubkey
 exists

The signature type is not covered by the signature, so an OpenSSL signed
phar could be downgraded to a keyless hash algorithm.

(cherry picked from commit 7050cf338092a93e7d4caa4b7dc0bb8771f52a01)
(cherry picked from commit 88287560c4a3945ad189e6bbf2436165fb73a767)
(cherry picked from commit 1a73af7b2445c7c5837ef66e9818c51739bb4e94)
(cherry picked from commit f41d31eeb93e3009a739a3ac25989cefe1968253)
(cherry picked from commit 09ce3861bf193c0bbdd87b0cab0fe37839d4aeb9)
(cherry picked from commit 0719d3cac6fe2fa0f73906d2975841d2ac9fb8c7)
(cherry picked from commit 418d878d39c7d9da02b356a62c5057037c237b77)
(cherry picked from commit 5eb063ca73b070ef7b2b45c06378a58759b91f3e)
